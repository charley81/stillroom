{
  "name": "stillroom",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "sanity:dataset:ensure": "tsx scripts/sanity/ensure-development-dataset.ts",
    "sanity:migrate": "tsx scripts/sanity/migrate-site-settings.ts",
    "sanity:migrate:publish": "tsx scripts/sanity/migrate-site-settings.ts --publish",
    "sanity:typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "sanity:typegen:check": "pnpm sanity:typegen && git diff --exit-code -- schema.json sanity.types.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.12",
    "@astrojs/react": "7.1.4",
    "@sanity/astro": "3.6.0",
    "@sanity/client": "8.15.0",
    "@sanity/image-url": "2.1.1",
    "@sanity/preview-url-secret": "4.1.5",
    "astro": "7.4.7",
    "groq": "6.22.0",
    "react": "19.3.1",
    "react-compiler-runtime": "1.0.0",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "sanity": "6.22.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-is": "19.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@astrojs/astro2tsx>@napi-rs/wasm-runtime": "1.2.7"
    }
  }
}
