{
  "name": "stillroom",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:site": "tsx scripts/verify-site.ts",
    "verify:production": "VERIFY_PRODUCTION=true SCREENSHOT_DIRECTORY=.sanity/screenshots/production tsx scripts/verify-site.ts",
    "sanity:dataset:ensure": "tsx scripts/sanity/ensure-development-dataset.ts",
    "sanity:migrate": "tsx scripts/sanity/migrate-site-settings.ts",
    "sanity:migrate:publish": "tsx scripts/sanity/migrate-site-settings.ts --publish",
    "sanity:migrate:services-contact": "tsx scripts/sanity/migrate-services-contact.ts",
    "sanity:migrate:services-contact:publish": "tsx scripts/sanity/migrate-services-contact.ts --publish",
    "sanity:migrate:work": "tsx scripts/sanity/migrate-work.ts",
    "sanity:migrate:work:publish": "tsx scripts/sanity/migrate-work.ts --publish",
    "sanity:migrate:journal": "tsx scripts/sanity/migrate-journal.ts",
    "sanity:migrate:journal:publish": "tsx scripts/sanity/migrate-journal.ts --publish",
    "sanity:migrate:about": "tsx scripts/sanity/migrate-about.ts",
    "sanity:migrate:about:publish": "tsx scripts/sanity/migrate-about.ts --publish",
    "sanity:migrate:home": "tsx scripts/sanity/migrate-home.ts",
    "sanity:migrate:home:publish": "tsx scripts/sanity/migrate-home.ts --publish",
    "sanity:migrate:all": "tsx scripts/sanity/migrate-all.ts",
    "sanity:migrate:all:publish": "tsx scripts/sanity/migrate-all.ts --publish",
    "sanity:validate:documents": "sanity documents validate --dataset development --yes --level error",
    "sanity:validate:production:documents": "sanity documents validate --dataset production --yes --level error",
    "sanity:validate:cutover": "tsx scripts/sanity/validate-cutover.ts",
    "sanity:validate:production:drafts": "SANITY_MIGRATION_DATASET=production SANITY_VALIDATION_PERSPECTIVE=drafts tsx scripts/sanity/validate-cutover.ts",
    "sanity:validate:production:published": "SANITY_MIGRATION_DATASET=production SANITY_VALIDATION_PERSPECTIVE=published tsx scripts/sanity/validate-cutover.ts",
    "sanity:compare:production:drafts": "tsx scripts/sanity/compare-datasets.ts --source=development --target=production --perspective=drafts",
    "sanity:compare:production:published": "tsx scripts/sanity/compare-datasets.ts --source=development --target=production --perspective=published",
    "sanity:dataset:export": "tsx scripts/sanity/export-development.ts",
    "sanity:dataset:export:production:pre": "tsx scripts/sanity/export-dataset.ts --dataset=production --label=pre-migration",
    "sanity:dataset:export:production:post": "tsx scripts/sanity/export-dataset.ts --dataset=production --label=post-migration",
    "sanity:launch:production": "tsx scripts/sanity/production-launch.ts",
    "sanity:verify:production-editorial": "tsx scripts/sanity/verify-production-editorial.ts",
    "sanity:typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "sanity:typegen:check": "pnpm sanity:typegen && git diff --exit-code -- schema.json sanity.types.ts",
    "sanity:cutover:check": "pnpm sanity:validate:documents && pnpm sanity:validate:cutover && pnpm sanity:typegen:check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.12",
    "@astrojs/react": "7.1.4",
    "@sanity/astro": "3.6.0",
    "@sanity/client": "8.15.0",
    "@sanity/image-url": "2.1.1",
    "@sanity/preview-url-secret": "4.1.5",
    "astro": "7.4.7",
    "groq": "6.22.0",
    "react": "19.3.1",
    "react-compiler-runtime": "1.0.0",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "sanity": "6.22.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@sanity/export": "7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-is": "19.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "25.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@astrojs/astro2tsx>@napi-rs/wasm-runtime": "1.2.7"
    }
  }
}
