---
import type { AboutPage } from '../../sanity/content'

interface Props {
  page: AboutPage
}

const { page } = Astro.props
---

<section class="relative isolate flex h-[1341px] flex-col gap-8 overflow-hidden bg-primary px-4 py-16 text-light after:absolute after:inset-0 after:-z-10 after:bg-dark after:opacity-[0.64] after:content-[''] md:h-[1104px] md:gap-16 md:px-8 md:py-32">
  <p class="m-0 font-body text-base leading-5 font-normal text-light uppercase">
    What we believe
  </p>
  <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-light uppercase md:text-[72px] md:leading-[1.05]">
    {page.principlesHeading}
  </h2>
  <div class="flex w-full flex-col gap-8 md:gap-16">
    {page.principles.map((principle, index) => (
      <article class="grid h-auto min-h-0 grid-cols-1 gap-8 bg-transparent py-8 text-light md:h-[140px] md:grid-cols-[144px_464px_704px]">
        <p class="m-0 self-center font-display text-[36px] leading-[1.05] font-normal uppercase">
          {String(index + 1).padStart(2, '0')}
        </p>
        <h3 class="m-0 whitespace-pre-line font-display text-[36px] leading-[1.05] font-normal uppercase">
          {principle.title}
        </h3>
        <p class="m-0 self-center text-base leading-[27px]">
          {principle.description}
        </p>
      </article>
    ))}
  </div>
</section>
