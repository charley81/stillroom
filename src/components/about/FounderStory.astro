---
import type { AboutPage } from '../../sanity/content/about'
import EditorialImage from '../content/EditorialImage.astro'
import PortableText from '../content/PortableText.astro'

interface Props {
  page: AboutPage
}

const { page } = Astro.props
---

<section class="grid min-h-[889.598px] w-full grid-cols-1 items-center gap-16 px-4 py-16 md:min-h-[716px] md:grid-cols-2 md:px-8 md:py-32">
  <EditorialImage
    class="h-[228.598px] w-full object-cover md:h-[460px] md:max-w-[656px]"
    image={page.founderImage}
    width={656}
    height={460}
  />
  <div class="flex flex-col gap-8">
    <p class="m-0 font-body text-base leading-5 font-normal text-dark-grey uppercase">
      Our story
    </p>
    <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[1.05]">
      {page.founderHeading}
    </h2>
    <div class="flex flex-col gap-4 leading-[27px] text-dark-grey">
      <PortableText value={page.founderStory} paragraphClass="m-0" />
    </div>
    <p class="m-0 leading-[24.3px] font-bold text-primary">
      {page.founderName} / {page.founderRole}
    </p>
  </div>
</section>
