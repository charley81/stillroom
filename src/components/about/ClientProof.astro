---
import type { AboutPage } from '../../sanity/content'
import ClientLogos from '../site/ClientLogos.astro'

interface Props {
  page: AboutPage
}

const { page } = Astro.props
---

<section class="flex min-h-[1123px] flex-col gap-8 px-4 py-16 text-left md:min-h-[995px] md:px-8 md:py-32">
  <p class="m-0 font-body text-base leading-5 font-normal text-primary uppercase">
    In good company
  </p>
  <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[1.05]">
    {page.clientProofHeading}
  </h2>
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-16">
    <p class="m-0 text-base leading-[27px] text-dark">{page.clientProofCopy}</p>
    <a
      class="m-0 text-left text-base leading-[24.3px] font-bold text-primary hover:text-dark md:text-right"
      href="/work"
    >
      {page.clientProofCtaLabel}
    </a>
  </div>
  <div class="flex min-h-0 flex-col gap-8 py-8 md:min-h-[417px]">
    <p class="m-0 font-body text-base leading-[14.85px] font-black text-dark-grey uppercase">
      Explorations in hospitality / Concept brands
    </p>
    <ClientLogos logos={page.clientLogos} variant="proof" />
  </div>
</section>
