---
import type { AboutPage } from '../../sanity/content'
import EditorialImage from '../content/EditorialImage.astro'

interface Props {
  page: AboutPage
}

const { page } = Astro.props
---

<section class="flex min-h-[2298.233px] flex-col gap-8 px-4 py-16 md:min-h-[1175px] md:gap-16 md:px-8 md:py-32">
  <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-2 md:gap-16">
    <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[1.05]">
      {page.teamHeading}
    </h2>
    <p class="m-0 leading-[27px] text-dark">{page.teamIntroduction}</p>
  </div>
  <div class="grid w-full grid-cols-1 gap-8 md:grid-cols-3">
    {page.teamMembers.map((person) => (
      <article class="flex flex-col gap-4 py-8 md:gap-8">
        <EditorialImage
          class="h-[358.078px] w-full rounded-md object-cover object-top md:h-[480px]"
          image={person.portrait}
          width={1122}
          height={1402}
        />
        <h3 class="m-0 font-display text-[36px] leading-[1.05] font-normal text-dark uppercase">
          {person.name}
        </h3>
        <p class="m-0 leading-5 text-primary uppercase">{person.role}</p>
        <p class="m-0 leading-[27px] text-dark-grey">{person.biography}</p>
      </article>
    ))}
  </div>
</section>
