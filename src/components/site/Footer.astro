---
import { stegaClean } from '@sanity/client/stega'
import type { SiteSettings } from '../../sanity/content'
import { splitRegisteredMark } from './wordmark'

interface Props {
  settings: SiteSettings
  currentYear?: number
}

const { settings, currentYear = new Date().getFullYear() } = Astro.props
const socialLinks = settings.socialLinks ?? []
const { text: wordmark, hasRegisteredMark } = splitRegisteredMark(
  stegaClean(settings.registeredMarkText),
)
const cleanEmailAddress = stegaClean(settings.emailAddress)
---

<footer class="min-h-[1118px] px-4 pt-16 pb-8 md:min-h-[530px] md:px-8">
  <div class="mx-auto grid max-w-none grid-cols-1 gap-[72px] md:grid-cols-2 md:gap-16">
    <section aria-labelledby="newsletter-title">
      <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
        A note from {settings.studioName}
      </p>
      <h2
        id="newsletter-title"
        class="my-4 font-display text-[36px] leading-[1.05] font-normal text-dark uppercase"
      >
        {settings.newsletterHeading}
      </h2>
      <p class="m-0 text-base leading-[27px] text-dark-grey">
        {settings.newsletterDescription}
      </p>
      <form
        class="mt-8 flex w-full max-w-[40rem] flex-col items-start gap-4"
        data-inactive-form
        novalidate
      >
        <label class="sr-only" for="newsletter-email">
          Your email address
        </label>
        <input
          class="min-h-16 w-full rounded-md border border-light-grey bg-transparent p-4 leading-[24.3px] text-dark-grey caret-primary placeholder:text-dark-grey"
          id="newsletter-email"
          name="email"
          type="email"
          placeholder="Your email address"
          required
        />
        <button
          class="cursor-pointer border-0 bg-transparent p-0 text-left font-bold leading-[24.3px] text-primary"
          type="submit"
        >
          Subscribe <span aria-hidden="true">→</span>
        </button>
        <p
          class="m-0 w-full text-[0.8rem] text-primary empty:hidden"
          data-form-status
          aria-live="polite"
        ></p>
      </form>
    </section>

    <nav
      class="grid grid-cols-1 gap-16 text-left md:grid-cols-2 md:gap-8 md:text-right"
      aria-label="Footer navigation"
    >
      <div class="flex flex-col gap-4 md:gap-[0.65rem]">
        <h3 class="m-0 font-body text-base leading-[24.3px] font-bold text-dark normal-case">
          Contact Us
        </h3>
        <a
          class="text-base leading-[27px] text-dark-grey hover:text-primary"
          href="/contact"
        >
          {settings.contactLabel}
        </a>
        <a
          class="text-base leading-[27px] text-dark-grey hover:text-primary"
          href={`mailto:${cleanEmailAddress}`}
          aria-label={`Email ${cleanEmailAddress}`}
        >
          Email
        </a>
        {socialLinks.map((link) => (
          <a
            class="text-base leading-[27px] text-dark-grey hover:text-primary"
            href={stegaClean(link.url)}
            target="_blank"
            rel="noreferrer"
          >
            {link.platform}
          </a>
        ))}
      </div>
      <div class="flex flex-col gap-4 md:gap-[0.65rem]">
        <h3 class="m-0 font-body text-base leading-[24.3px] font-bold text-dark normal-case">
          Company
        </h3>
        <a
          class="text-base leading-[27px] text-dark-grey hover:text-primary"
          href="/"
        >
          {settings.homeLabel}
        </a>
        <a
          class="text-base leading-[27px] text-dark-grey hover:text-primary"
          href="/about"
        >
          {settings.aboutLabel}
        </a>
        <a
          class="text-base leading-[27px] text-dark-grey hover:text-primary"
          href="/work"
        >
          {settings.workLabel}
        </a>
        <a
          class="text-base leading-[27px] text-dark-grey hover:text-primary"
          href="/services"
        >
          {settings.servicesLabel}
        </a>
        <a
          class="text-base leading-[27px] text-dark-grey hover:text-primary"
          href="/journal"
        >
          {settings.journalLabel}
        </a>
      </div>
    </nav>
  </div>
  <a
    class="my-16 block max-w-none font-display text-[36px] leading-[1.05] font-normal text-dark lowercase md:mx-auto md:mt-16 md:mb-12"
    href="/"
  >
    {wordmark}
    {hasRegisteredMark && <span class="text-primary">®</span>}
  </a>
  <div class="mx-auto flex max-w-none flex-col gap-4 text-base leading-[24.3px] font-bold text-muted md:flex-row md:gap-32">
    <span>
      © {settings.studioName} {currentYear}
    </span>
    <span>{settings.footerTagline}</span>
  </div>
</footer>

<script>
  document
    .querySelectorAll<HTMLFormElement>('[data-inactive-form]')
    .forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault()
        const status = form.querySelector<HTMLElement>('[data-form-status]')
        if (!form.reportValidity()) return
        if (status)
          status.textContent =
            'This form is ready to connect to your newsletter service.'
      })
    })
</script>
