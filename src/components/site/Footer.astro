<script>
  document
    .querySelectorAll<HTMLFormElement>('[data-inactive-form]')
    .forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault()
        const status = form.querySelector<HTMLElement>('[data-form-status]')
        if (!form.reportValidity()) return
        if (status)
          status.textContent =
            'This form is ready to connect to your newsletter service.'
      })
    })
</script>
