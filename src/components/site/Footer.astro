          id="newsletter-email"
          name="email"
          type="email"
          placeholder="Your email address"
          required
        />
        <button
          class="cursor-pointer border-0 bg-transparent p-0 text-left font-bold leading-[24.3px] text-primary"
          type="submit"
        >
          Subscribe <span aria-hidden="true">→</span>
        </button>
        <p
          class="m-0 w-full text-[0.8rem] text-primary empty:hidden"
          data-form-status
          aria-live="polite"
        ></p>
      </form>
    </section>

    <nav
