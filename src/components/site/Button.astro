---
interface Props {
  href?: string
  variant?: 'outline' | 'solid' | 'light'
  type?: 'button' | 'submit'
  class?: string
}

const {
  href,
  variant = 'outline',
  type = 'button',
  class: className = '',
} = Astro.props

const baseClasses =
  'inline-flex min-h-14 w-full cursor-pointer items-center justify-center gap-[0.45rem] rounded-full border-2 px-4 py-3 text-center text-base leading-tight font-bold transition-colors duration-200 md:w-[210px]'
const variantClasses = {
  outline:
    'border-primary bg-light text-dark hover:bg-primary hover:text-light',
  solid: 'border-primary bg-primary text-light hover:border-dark hover:bg-dark',
  light:
    'border-primary bg-transparent text-light hover:bg-primary hover:text-light',
}
---

{href ? (
  <a class:list={[baseClasses, variantClasses[variant], className]} href={href}>
    <slot /> <span aria-hidden="true">→</span>
  </a>
) : (
  <button
    class:list={[baseClasses, variantClasses[variant], className]}
    type={type}
  >
    <slot /> <span aria-hidden="true">→</span>
  </button>
)}
