---
import { stegaClean } from '@sanity/client/stega'
import { Image } from 'astro:assets'
import type { SiteSettings } from '../../sanity/content'
import Button from './Button.astro'
import { splitRegisteredMark } from './wordmark'

interface Props {
  settings: SiteSettings
  pathname?: string
}

const { settings, pathname = Astro.url.pathname } = Astro.props
const links = [
  { href: '/work', label: settings.workLabel },
  { href: '/services', label: settings.servicesLabel },
  { href: '/about', label: settings.aboutLabel },
  { href: '/journal', label: settings.journalLabel },
]
const { text: wordmark, hasRegisteredMark } = splitRegisteredMark(
  stegaClean(settings.registeredMarkText),
)
const cleanStudioName = stegaClean(settings.studioName)

const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`)
---

<header class="relative z-20 grid min-h-[108px] grid-cols-[1fr_auto] items-center px-4 py-8 md:min-h-[120px] md:grid-cols-[auto_minmax(0,1fr)_auto] md:gap-4 md:px-8">
  <a
    class="min-w-0 [overflow-wrap:anywhere] font-display text-[36px] leading-[36px] font-normal tracking-normal text-dark lowercase"
    href="/"
    aria-label={`${cleanStudioName} home`}
  >
    {wordmark}
    {hasRegisteredMark && <span class="text-primary">®</span>}
  </a>
  <nav
    class="hidden w-full max-w-[550px] items-center justify-center gap-[clamp(0.5rem,2vw,4rem)] md:flex"
    aria-label="Primary navigation"
  >
    {links.map((link) => (
      <a
        class:list={[
          'min-w-0 flex-1 text-center text-base leading-[20.25px] font-bold hover:text-primary',
          isActive(link.href) ? 'text-primary' : 'text-dark-grey',
        ]}
        href={link.href}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <div class="hidden justify-self-end md:block">
    <Button href="/contact" class="md:!w-[clamp(9rem,14.6vw,13.125rem)]">
      {settings.headerCtaLabel}
    </Button>
  </div>
  <button
    class="grid size-11 place-items-center justify-self-end border-0 bg-transparent p-2.5 md:hidden"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-menu-open
  >
    <span class="sr-only">Open menu</span>
    <Image
      class="size-6"
      src="/figma-assets/menu.svg"
      alt=""
      width={24}
      height={24}
    />
  </button>
</header>

<div
  class="fixed inset-0 z-50 overflow-y-auto bg-dark px-4 py-8 text-light"
  id="mobile-menu"
  hidden
  data-mobile-menu
>
  <div class="flex items-center justify-between">
    <a
      class="font-display text-[36px] leading-[36px] font-normal text-light lowercase"
      href="/"
    >
      {wordmark}
      {hasRegisteredMark && <span>®</span>}
    </a>
    <button
      class="border-0 bg-transparent text-[2.5rem] text-light"
      type="button"
      aria-label="Close menu"
      data-menu-close
    >
      ×
    </button>
  </div>
  <nav class="mt-20 grid gap-4" aria-label="Mobile navigation">
    {links.map((link) => (
      <a
        class="[overflow-wrap:anywhere] font-display text-[clamp(2.8rem,14vw,5rem)] leading-none uppercase hover:text-primary"
        href={link.href}
      >
        {link.label}
      </a>
    ))}
    <a
      class="[overflow-wrap:anywhere] font-display text-[clamp(2.8rem,14vw,5rem)] leading-none uppercase hover:text-primary"
      href="/contact"
    >
      {settings.headerCtaLabel} →
    </a>
  </nav>
</div>

<script>
  const openButton =
    document.querySelector<HTMLButtonElement>('[data-menu-open]')
  const closeButton =
    document.querySelector<HTMLButtonElement>('[data-menu-close]')
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')

  function setMenu(open: boolean) {
    if (!openButton || !menu) return
    openButton.setAttribute('aria-expanded', String(open))
    menu.hidden = !open
    document.body.classList.toggle('overflow-hidden', open)
    if (open) closeButton?.focus()
    else openButton.focus()
  }

  openButton?.addEventListener('click', () => setMenu(true))
  closeButton?.addEventListener('click', () => setMenu(false))
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) setMenu(false)
  })
</script>
