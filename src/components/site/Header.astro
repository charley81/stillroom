---
import Button from './Button.astro'

const pathname = Astro.url.pathname
const links = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/journal', label: 'Journal' },
]

const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`)
---

<header class="relative z-20 grid h-[108px] grid-cols-[1fr_auto] items-center px-8 py-8 md:h-[120px] md:grid-cols-[1fr_auto_1fr]">
  <a
    class="font-display text-[36px] leading-[36px] font-normal tracking-normal text-dark lowercase"
    href="/"
    aria-label="Stillroom home"
  >
    stillroom<span class="text-primary">®</span>
  </a>
  <nav
    class="hidden w-[550px] items-center justify-center gap-16 md:flex"
    aria-label="Primary navigation"
  >
    {links.map((link) => (
      <a
        class:list={[
          'w-[90px] text-base leading-[20.25px] font-bold hover:text-primary',
          isActive(link.href) ? 'text-primary' : 'text-dark-grey',
        ]}
        href={link.href}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <div class="hidden justify-self-end md:block">
    <Button href="/contact">Start a Project</Button>
  </div>
  <button
    class="grid size-11 place-items-center justify-self-end border-0 bg-transparent p-2.5 md:hidden"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-menu-open
  >
    <span class="sr-only">Open menu</span>
    <img
      class="size-6"
      src="/figma-assets/menu.svg"
      alt=""
      width="24"
      height="24"
    />
  </button>
</header>

<div
  class="fixed inset-0 z-50 bg-dark px-4 py-8 text-light"
  id="mobile-menu"
  hidden
  data-mobile-menu
>
  <div class="flex items-center justify-between">
    <a
      class="font-display text-[36px] leading-[36px] font-normal text-light lowercase"
      href="/"
    >
      stillroom<span>®</span>
    </a>
    <button
      class="border-0 bg-transparent text-[2.5rem] text-light"
      type="button"
      aria-label="Close menu"
      data-menu-close
    >
      ×
    </button>
  </div>
  <nav class="mt-20 grid gap-4" aria-label="Mobile navigation">
    {links.map((link) => (
      <a
        class="font-display text-[clamp(2.8rem,14vw,5rem)] leading-none uppercase hover:text-primary"
        href={link.href}
      >
        {link.label}
      </a>
    ))}
    <a
      class="font-display text-[clamp(2.8rem,14vw,5rem)] leading-none uppercase hover:text-primary"
      href="/contact"
    >
      Start a Project →
    </a>
  </nav>
</div>

<script>
  const openButton =
    document.querySelector<HTMLButtonElement>('[data-menu-open]')
  const closeButton =
    document.querySelector<HTMLButtonElement>('[data-menu-close]')
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')

  function setMenu(open: boolean) {
    if (!openButton || !menu) return
    openButton.setAttribute('aria-expanded', String(open))
    menu.hidden = !open
    document.body.classList.toggle('overflow-hidden', open)
    if (open) closeButton?.focus()
    else openButton.focus()
  }

  openButton?.addEventListener('click', () => setMenu(true))
  closeButton?.addEventListener('click', () => setMenu(false))
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) setMenu(false)
  })
</script>
