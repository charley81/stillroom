---
import type { ServicesPage } from '../../sanity/content'

interface Props {
  page: ServicesPage
}

const { page } = Astro.props
---

<section class="flex min-h-[846px] flex-col px-4 py-16 md:min-h-[637px] md:px-8 md:py-32">
  <div class="flex w-full max-w-none flex-col gap-8 p-0">
    <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
      How the work connects
    </p>
    <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[1.05]">
      {page.processHeading}
    </h2>
  </div>
  <div class="mt-16 grid w-full max-w-none grid-cols-1 gap-8 md:grid-cols-4">
    {page.processSteps.map((phase, index) => (
      <div class="flex flex-col gap-4">
        <h3 class="m-0 font-display text-[36px] leading-[1.05] font-normal text-dark uppercase">
          <span class="text-primary">{String(index + 1).padStart(2, '0')}</span>{' '}
          {phase.title}
        </h3>
        <p class="m-0 w-full max-w-72 text-base leading-[27px] text-dark-grey">
          {phase.description}
        </p>
      </div>
    ))}
  </div>
</section>
