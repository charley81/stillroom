---
import { stegaClean } from '@sanity/client/stega'
import { Image } from 'astro:assets'
import type { ServicesPage } from '../../sanity/content'
import EditorialImage from '../content/EditorialImage.astro'

interface Props {
  page: ServicesPage
}

const { page } = Astro.props
const numberImages = [
  '/figma-assets/number-1.png',
  '/figma-assets/number-2.png',
  '/figma-assets/number-3.png',
  '/figma-assets/number-4.png',
]

function serviceTitleLines(title: string, index: number) {
  const words = stegaClean(title).split(/\s+/)
  if (words.length < 2) return [title]
  if (index < 2) return [words[0], words.slice(1).join(' ')]
  if (index === 2) {
    const separator = words.indexOf('&')
    return separator > 0
      ? [words.slice(0, separator).join(' '), words.slice(separator).join(' ')]
      : [title]
  }
  const separator = words.indexOf('&')
  return separator >= 0
    ? [
        words.slice(0, separator + 1).join(' '),
        words.slice(separator + 1).join(' '),
      ]
    : [title]
}
---

<section class="flex h-[3440.238px] flex-col gap-8 overflow-hidden px-4 py-16 md:h-[2187px] md:px-8 md:py-32">
  <p class="m-0 font-body text-base leading-[24.3px] font-bold text-dark-grey uppercase">
    Our services
  </p>
  <div class="grid max-w-none grid-cols-1 gap-8 p-0 md:grid-cols-2">
    {page.services.map((service, index) => {
      const titleLines = serviceTitleLines(service.title, index)
      return (
        <article class="flex h-auto min-h-0 flex-col gap-8 overflow-hidden md:h-[921px]">
          <EditorialImage
            class="h-[201.81px] w-full shrink-0 object-cover md:h-72"
            image={service.image}
            width={600}
            height={600}
          />
          <Image
            class="size-24 shrink-0 object-contain md:size-28"
            src={numberImages[index]}
            alt=""
            width={1254}
            height={1254}
          />
          <h2 class="m-0 font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[1.05]">
            {titleLines.map((line, lineIndex) => (
              <>
                {lineIndex > 0 && <br />}
                {line}
              </>
            ))}
          </h2>
          <p class="m-0 w-full text-base leading-[27px] text-dark md:w-[calc(100%_-_64px)]">
            {service.description}
          </p>
          <h3 class="m-0 w-full font-body text-base leading-5 font-normal text-primary uppercase md:w-[calc(100%_-_64px)]">
            What we shape
          </h3>
          <ul class="m-0 w-full list-none p-0 text-base leading-[27px] text-dark-grey md:w-[calc(100%_-_64px)]">
            {service.deliverables.map((deliverable) => (
              <li>{deliverable}</li>
            ))}
          </ul>
        </article>
      )
    })}
  </div>
</section>
