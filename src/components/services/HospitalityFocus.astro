---
import { stegaClean } from '@sanity/client/stega'
import type { ServicesPage } from '../../sanity/content/services-contact'
import EditorialImage from '../content/EditorialImage.astro'

interface Props {
  page: ServicesPage
}

const { page } = Astro.props
const sectorLabels = page.hospitalitySectorLabels.map((label) =>
  stegaClean(label),
)
const sectorBreak = Math.ceil(sectorLabels.length / 2)
const firstSectorLine = sectorLabels.slice(0, sectorBreak).join(' / ')
const secondSectorLine = sectorLabels.slice(sectorBreak).join(' / ')
---

<section class="flex min-h-[927.81px] flex-col gap-8 px-4 py-16 md:min-h-[913px] md:px-8 md:py-32">
  <div class="flex w-full max-w-none flex-col gap-8 p-0">
    <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
      Made for hospitality
    </p>
    <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[1.05]">
      {page.hospitalityHeading}
    </h2>
  </div>
  <div class="grid min-h-0 w-full max-w-none grid-cols-1 gap-16 md:min-h-[416px] md:grid-cols-[minmax(0,20fr)_minmax(0,21fr)] xl:grid-cols-[640px_672px]">
    <div class="flex flex-col justify-center gap-8">
      <h3 class="m-0 font-display text-[36px] leading-[1.05] font-normal text-dark uppercase">
        {firstSectorLine}
        {secondSectorLine && (
          <>
            <br />
            {secondSectorLine}
          </>
        )}
      </h3>
      <p class="m-0 w-full max-w-[608px] text-base leading-[27px] text-dark-grey">
        Our point of view / {page.hospitalityPointOfView}
      </p>
      <a
        class="leading-[24.3px] font-bold text-primary hover:text-dark"
        href="/work"
      >
        {page.hospitalityCtaLabel}&nbsp; ↗
      </a>
    </div>
    <EditorialImage
      class="h-[201.81px] w-full rounded-md object-cover md:h-[416px] md:max-w-[672px]"
      image={page.hospitalityImage}
      width={672}
      height={416}
    />
  </div>
</section>
