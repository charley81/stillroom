---
import type { HomePage } from '../../sanity/content/home'
import EditorialImage from '../content/EditorialImage.astro'

interface Props {
  page: HomePage
}

const { page } = Astro.props
---

<section class="flex min-h-[1027.069px] flex-col gap-8 px-4 py-16 md:min-h-[955px] md:px-8 md:py-32">
  <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
    <span class="hidden md:inline">Selected concepts</span>
    <span class="inline md:hidden">Selected projects</span>
  </p>
  <div class="flex w-full flex-col items-start justify-between gap-8 md:flex-row md:items-center">
    <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[71.4px]">
      {page.featuredWorkHeading}
    </h2>
    <a
      class="text-base leading-[20.25px] font-black text-primary hover:text-dark"
      href="/work"
    >
      {page.featuredWorkCtaLabel}
    </a>
  </div>
  <div class="grid w-full grid-cols-1 gap-8 md:grid-cols-2">
    {page.featuredWorkProjects.map((project) => (
      <article class="w-full">
        <a href={`/work/${project.slug}`} aria-label={`View ${project.title}`}>
          <EditorialImage
            class="h-[225.535px] w-full object-cover md:h-[440px]"
            image={project.cardImage}
            width={636}
            height={440}
            sizes="(min-width: 768px) calc(50vw - 48px), calc(100vw - 32px)"
          />
        </a>
        <h3 class="my-8 mb-4 font-display text-[36px] leading-[35.2px] font-normal text-dark uppercase">
          <a class="hover:text-primary" href={`/work/${project.slug}`}>
            {project.title} <span class="ml-4 text-primary">→</span>
          </a>
        </h3>
        <p class="m-0 text-base leading-[21.6px] text-dark-grey">
          {project.cardSummary}
        </p>
      </article>
    ))}
  </div>
</section>
