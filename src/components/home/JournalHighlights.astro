---
import type { HomePage } from '../../sanity/content/home'
import EditorialImage from '../content/EditorialImage.astro'

interface Props {
  page: HomePage
}

const { page } = Astro.props
---

<section class="flex min-h-[1496.276px] flex-col gap-8 px-4 py-16 md:min-h-[872px] md:px-8 md:py-32">
  <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
    <span class="hidden md:inline">05 / Notes from Stillroom</span>
    <span class="inline md:hidden">Notes from Stillroom</span>
  </p>
  <div class="flex w-full flex-col items-start justify-between gap-8 md:flex-row md:items-center">
    <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[71.4px]">
      {page.journalHeading}
    </h2>
    <a
      class="text-base leading-[20.25px] font-black text-primary hover:text-dark"
      href="/journal"
    >
      {page.journalCtaLabel}
    </a>
  </div>
  <div class="grid min-h-[1186.276px] w-full grid-cols-1 gap-8 md:min-h-[463px] md:grid-cols-3">
    {page.featuredJournalArticles.map((article, index) => (
      <article
        class:list={[
          'flex min-h-[350.092px] flex-col gap-4 bg-light px-4 py-8 md:min-h-[463px]',
          index < 2 && 'min-h-[386.092px]',
        ]}
      >
        <a href={`/journal/${article.slug}`}>
          <EditorialImage
            class="h-[203.092px] w-full object-cover md:h-[280px]"
            image={article.heroImage}
            width={406}
            height={280}
            sizes="(min-width: 768px) calc(33.333vw - 53.333px), calc(100vw - 64px)"
          />
        </a>
        <p class="m-0 text-base leading-[14.85px] text-primary uppercase">
          {article.category.title} / {article.readingTime}
        </p>
        <h3 class="m-0 font-display text-[36px] leading-[35.84px] font-normal text-dark uppercase">
          <a class="hover:text-primary" href={`/journal/${article.slug}`}>
            {article.title}
          </a>
        </h3>
      </article>
    ))}
  </div>
</section>
