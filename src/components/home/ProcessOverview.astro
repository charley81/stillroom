---
import { Image } from 'astro:assets'
import type { HomePage } from '../../sanity/content'

interface Props {
  page: HomePage
}

const { page } = Astro.props
---

<section class="flex min-h-[1603px] flex-col gap-8 px-4 py-16 md:min-h-[724px] md:px-8 md:py-32">
  <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
    <span class="hidden md:inline">How we work</span>
    <span class="inline md:hidden">How we work</span>
  </p>
  <div class="flex w-full flex-col items-start justify-between gap-8 md:flex-row md:items-center">
    <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[71.4px]">
      {page.processHeading}
    </h2>
    <a
      class="text-base leading-[21.6px] font-black text-primary hover:text-dark"
      href="/services"
    >
      {page.processCtaLabel}
    </a>
  </div>
  <div class="grid min-h-[1292px] w-full grid-cols-1 gap-8 md:min-h-[315px] md:grid-cols-4">
    {page.processSteps.map((step, index) => (
      <article class="flex min-h-[299px] flex-col items-center gap-8 rounded-md border border-light-grey p-4 text-center">
        <Image
          class="size-24 object-contain md:size-28"
          src={`/figma-assets/number-${index + 1}.png`}
          alt=""
          width={112}
          height={112}
        />
        <h3 class="m-0 font-display text-[36px] leading-[35.2px] font-normal text-dark uppercase">
          {step.title}
        </h3>
        <p class="m-0 whitespace-pre-line text-base leading-[22.95px] text-dark-grey">
          {step.description}
        </p>
      </article>
    ))}
  </div>
</section>
