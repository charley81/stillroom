---
import type { HomePage } from '../../sanity/content/home'
import EditorialImage from '../content/EditorialImage.astro'
import Button from '../site/Button.astro'

interface Props {
  page: HomePage
}

const { page } = Astro.props
---

<section class="flex min-h-[512px] flex-col items-center gap-16 px-4 py-16 text-center md:min-h-[1200px] md:gap-8 md:px-16 md:py-32">
  <p class="m-0 w-full font-body text-base leading-[15.6px] font-normal text-dark-grey uppercase">
    Brand strategy, identity & websites for independent hospitality
  </p>
  <h1 class="m-0 w-full whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[128px] md:leading-[158px]">
    {page.heroHeading}
  </h1>
  <div class="flex w-full flex-col justify-center gap-4 md:flex-row md:gap-10">
    <Button href="/contact" variant="solid">
      {page.heroPrimaryCtaLabel}
    </Button>
    <Button href="/work">{page.heroSecondaryCtaLabel}</Button>
  </div>
  <EditorialImage
    class="hidden h-[460px] w-full max-w-[1312px] object-cover md:block"
    image={page.heroImage}
    width={2116}
    height={743}
    sizes="(min-width: 1440px) 1312px, (min-width: 768px) calc(100vw - 128px), 1px"
    loading="eager"
    fetchpriority="high"
  />
</section>
