---
import type { HomePage } from '../../sanity/content'
import EditorialImage from '../content/EditorialImage.astro'

interface Props {
  page: HomePage
}

const { page } = Astro.props
---

<section class="grid min-h-[695.155px] grid-cols-1 items-center gap-8 px-4 py-16 md:min-h-[716px] md:grid-cols-2 md:px-8 md:py-32">
  <div class="flex min-h-[312px] flex-col gap-8 p-0 md:min-h-[460px] md:py-[64.5px] md:pr-[52px]">
    <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
      <span class="hidden md:inline">The studio</span>
      <span class="inline md:hidden">The studio</span>
    </p>
    <h2 class="m-0 whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[70.72px]">
      {page.studioHeading}
    </h2>
    <p class="m-0 w-full max-w-[620px] text-base leading-[27px] text-dark-grey">
      {page.studioIntroduction}
    </p>
    <a
      class="text-base leading-[21.6px] font-black text-primary hover:text-dark"
      href="/about"
    >
      {page.studioCtaLabel}
    </a>
  </div>
  <EditorialImage
    class="h-[223.155px] w-full max-w-none object-cover md:h-[460px]"
    image={page.studioImage}
    width={672}
    height={460}
  />
</section>
