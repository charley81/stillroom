---
import type { JournalArticle } from '../../sanity/content/journal'
import PortableText from '../content/PortableText.astro'

interface Props {
  article: JournalArticle
}

const { article } = Astro.props
const sectionKeys = article.body.flatMap((block) =>
  block._type === 'journalArticleSection' ? [block._key] : [],
)
const lastSectionIndex = article.body.reduce(
  (lastIndex, block, index) =>
    block._type === 'journalArticleSection' ? index : lastIndex,
  -1,
)
---

{article.body.map((block, index) => {
  if (block._type === 'journalArticlePullQuote') {
    return (
      <section class="flex flex-col gap-10 bg-primary px-4 py-16 text-light md:min-h-[620px] md:p-32">
        {block.label && (
          <p class="m-0 font-body text-base leading-5 font-normal uppercase">
            {block.label}
          </p>
        )}
        <blockquote class="m-0 max-w-[1184px] font-display text-[38px] leading-[1.05] font-normal uppercase md:text-[72px]">
          “{block.quote}”
        </blockquote>
      </section>
    )
  }

  const sectionNumber = sectionKeys.indexOf(block._key)
  return (
    <section
      class:list={[
        'grid w-full grid-cols-1 gap-8 px-4 py-16 md:grid-cols-[minmax(0,4fr)_minmax(0,9fr)] md:px-8 md:py-32 xl:grid-cols-[320px_720px]',
        sectionNumber === 0 && 'min-h-[1533px] md:min-h-[1150px]',
        sectionNumber === 1 && 'min-h-[1409px] md:min-h-[1188px]',
      ]}
    >
      <p class="m-0 font-body text-base leading-5 font-normal text-primary uppercase">
        {block.label}
      </p>
      <div class="flex w-full min-w-0 flex-col gap-8 md:max-w-[720px]">
        <PortableText
          value={block.content}
          paragraphClass="m-0 text-base leading-[27px] text-dark-grey"
          headingClass="m-0 font-display text-[36px] leading-[1.05] font-normal text-dark uppercase"
        />
        {index === lastSectionIndex && (
          <div class="mt-0 flex flex-col gap-8 border-t border-light-grey py-8">
            <p class="m-0 text-base leading-[27px] text-dark">
              <strong>WORDS BY {article.author.name.toUpperCase()}</strong>
            </p>
            <p class="m-0 max-w-[640px] text-base leading-[27px] text-dark-grey">
              {article.author.biography}
            </p>
            <a
              class="leading-[24.3px] font-bold text-primary hover:text-dark"
              href="/journal"
            >
              ← Back to Journal
            </a>
          </div>
        )}
      </div>
    </section>
  )
})}
