---
import { formatJournalDate } from '../journal/date'
import type { JournalArticleCard } from '../../sanity/content/journal'
import EditorialImage from './EditorialImage.astro'

interface Props {
  article: JournalArticleCard
  variant?: 'listing' | 'related'
}

const { article, variant = 'listing' } = Astro.props
const href = `/journal/${article.slug}`
const date = formatJournalDate(article.publicationDate, 'short')
const cardHeight =
  variant === 'related'
    ? 'min-h-[512.333px] md:min-h-[664px]'
    : 'h-auto md:min-h-[664px]'
const imageClasses =
  'h-[217.333px] w-full object-cover transition-transform duration-200 md:h-[448px]'
---

<article class:list={['flex flex-col gap-4', cardHeight]}>
  <a
    class="group mb-1 block overflow-hidden"
    href={href}
    aria-label={`Read ${article.title}`}
  >
    <EditorialImage
      class={`${imageClasses} group-hover:scale-[1.015]`}
      image={article.heroImage}
      width={672}
      height={448}
      sizes="(min-width: 768px) calc(50vw - 48px), calc(100vw - 32px)"
    />
  </a>
  <p class="m-0 font-body text-base leading-5 font-normal text-dark uppercase">
    {article.category.title} / {article.readingTime}
  </p>
  <h2 class="m-0 font-display text-[36px] leading-[1.05] font-normal text-dark uppercase">
    <a class="hover:text-primary" href={href}>
      {article.title}
    </a>
  </h2>
  <p class="m-0 text-base leading-[27px] text-dark-grey">
    {article.standfirst}
  </p>
  <div class="m-0 flex flex-col gap-8 text-base leading-5 text-dark md:flex-row md:justify-between md:gap-4">
    <time datetime={article.publicationDate}>{date}</time>
    <a class="font-bold text-primary hover:text-dark" href={href}>
      Read the story →
    </a>
  </div>
</article>
