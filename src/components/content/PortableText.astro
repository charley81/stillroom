---
import {
  renderPortableText,
  type PortableTextBlock,
} from '../../sanity/portable-text'

interface Props {
  value: PortableTextBlock[]
  paragraphClass: string
  headingClass?: string
}

const { value, paragraphClass, headingClass } = Astro.props
const html = renderPortableText(value, paragraphClass, headingClass)
---

<Fragment set:html={html} />
