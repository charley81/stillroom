---
import type { WorkProjectCard } from '../../sanity/content/work'
import EditorialImage from './EditorialImage.astro'

interface Props {
  project: WorkProjectCard
}

const { project } = Astro.props
const href = `/work/${project.slug}`
const imageClasses =
  'h-[244.5px] w-full object-cover transition-transform duration-200 md:h-[504px]'
---

<article class="min-h-0 md:min-h-[669px]">
  <a
    class="group mb-4 block h-[244.5px] overflow-hidden md:h-[504px]"
    href={href}
    aria-label={`View ${project.title}`}
  >
    <EditorialImage
      class={`${imageClasses} group-hover:scale-[1.015]`}
      image={project.cardImage}
      width={672}
      height={504}
      loading="lazy"
    />
  </a>
  <h2 class="m-0 mb-4 font-display text-[36px] leading-[1.05] font-normal text-dark uppercase md:min-h-[38px]">
    <a class="hover:text-primary" href={href}>
      {project.title}{' '}
      <span class="text-primary" aria-hidden="true">
        →
      </span>
    </a>
  </h2>
  <p class="m-0 mb-2 font-body text-base leading-[24.3px] font-bold text-dark-grey uppercase">
    <span>{project.sectorLabel} | </span>
    <span class="text-primary">View project</span>
  </p>
  <p class="m-0 mb-2 text-base leading-[27px] text-dark">
    {project.cardSummary}
  </p>
  <p class="m-0 text-base leading-[27px] text-dark-grey">
    {project.services.map((service) => service.title).join(' / ')}
  </p>
</article>
