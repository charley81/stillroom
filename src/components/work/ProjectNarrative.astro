---
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'workProjects'>
}

const { project } = Astro.props
const sections = [
  { label: 'The challenge', ...project.data.challenge },
  { label: 'Our contribution', ...project.data.contribution },
]
---

<section class="flex flex-col gap-32 overflow-hidden px-4 py-16 md:px-8 md:py-32">
  {sections.map((section) => (
    <div class="grid w-full grid-cols-1 gap-8 md:grid-cols-[320px_1fr]">
      <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
        {section.label}
      </p>
      <div class="flex flex-col gap-4">
        <h2 class="m-0 max-w-[1024px] font-display text-[36px] leading-[1.05] font-normal text-dark uppercase">
          {section.heading}
        </h2>
        <p class="m-0 w-full text-base leading-[27px] text-dark-grey md:max-w-[784px]">
          {section.copy}
        </p>
      </div>
    </div>
  ))}
</section>
