---
import type { WorkProject } from '../../sanity/content/work'
import EditorialImage from '../content/EditorialImage.astro'

interface Props {
  project: WorkProject
}

const { project } = Astro.props
---

<section class="px-4 md:px-8">
  <div class="grid w-full gap-8">
    <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
      {project.galleryHeading}
    </p>
    {project.gallery.map((block) =>
      block._type === 'workProjectGalleryImage' ? (
        <EditorialImage
          class="h-[203.75px] w-full object-cover md:h-[860px]"
          image={block.image}
          width={1376}
          height={860}
          sizes="(min-width: 768px) calc(100vw - 64px), calc(100vw - 32px)"
        />
      ) : (
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <div class="flex min-h-[451px] flex-col justify-center gap-8 bg-primary p-16 text-light md:min-h-[760px]">
            <div class="flex flex-col gap-8">
              <h2 class="m-0 font-display text-5xl leading-12 font-normal uppercase md:text-[128px] md:leading-[1.05]">
                {block.title}
              </h2>
              <h3 class="m-0 font-display text-[36px] leading-[1.05] font-normal uppercase">
                {block.statement}
              </h3>
            </div>
            <p class="m-0 font-display text-base leading-normal font-normal uppercase">
              {block.label}
            </p>
          </div>
          <EditorialImage
            class="h-[368.69px] w-full object-cover md:h-[760px]"
            image={block.image}
            width={672}
            height={760}
            sizes="(min-width: 768px) calc(50vw - 48px), calc(100vw - 32px)"
          />
        </div>
      ),
    )}
  </div>
</section>
