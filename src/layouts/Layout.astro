---
import { Font } from 'astro:assets'
import Footer from '../components/site/Footer.astro'
import Header from '../components/site/Header.astro'
import { getSiteSettings } from '../sanity/content'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  showFooter?: boolean
}

const settings = await getSiteSettings()
const {
  title = settings.defaultSeoTitle,
  description = settings.defaultSeoDescription,
  showFooter = true,
} = Astro.props

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-light motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={settings.defaultSocialImage.url} />
    <meta property="og:site_name" content={settings.studioName} />
    <meta name="theme-color" content="#fff7eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font
      cssVariable="--font-anton"
      preload={[{ weight: 400, style: 'normal', subset: 'latin' }]}
    />
    <Font
      cssVariable="--font-dm-sans"
      preload={[{ weight: 400, style: 'normal', subset: 'latin' }]}
    />
    <slot name="head" />
  </head>
  <body class="m-0 bg-light font-body text-base leading-[1.55] text-dark">
    <Header settings={settings} pathname={pathname} />
    <main
      id="main-content"
      class:list={{ 'overflow-hidden': pathname !== '/' }}
    >
      <slot />
    </main>
    {showFooter && <Footer settings={settings} />}
  </body>
</html>
