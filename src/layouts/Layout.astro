---
import { stegaClean } from '@sanity/client/stega'
import { VisualEditing } from '@sanity/astro/visual-editing'
import { Font } from 'astro:assets'
import Footer from '../components/site/Footer.astro'
import Header from '../components/site/Header.astro'
import { getSiteSettings } from '../sanity/content'
import { PUBLIC_PREVIEW_STATE } from '../sanity/preview'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  socialImageUrl?: string
  showFooter?: boolean
}

const preview = Astro.locals.preview ?? PUBLIC_PREVIEW_STATE
const settings = await getSiteSettings(preview)
const {
  title = settings.defaultSeoTitle,
  description = settings.defaultSeoDescription,
  socialImageUrl = settings.defaultSocialImage.url,
  showFooter = true,
} = Astro.props

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'
const cleanTitle = stegaClean(title)
const cleanDescription = stegaClean(description)
const cleanSocialImageUrl = stegaClean(socialImageUrl)
const cleanStudioName = stegaClean(settings.studioName)
const exitPreviewHref = `/api/preview/exit?redirect=${encodeURIComponent(pathname)}`
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-light motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={cleanDescription} />
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:image" content={cleanSocialImageUrl} />
    <meta property="og:site_name" content={cleanStudioName} />
    <meta name="theme-color" content="#fff7eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{cleanTitle}</title>
    <Font
      cssVariable="--font-anton"
      preload={[{ weight: 400, style: 'normal', subset: 'latin' }]}
    />
    <Font
      cssVariable="--font-dm-sans"
      preload={[{ weight: 400, style: 'normal', subset: 'latin' }]}
    />
    <slot name="head" />
  </head>
  <body class="m-0 bg-light font-body text-base leading-[1.55] text-dark">
    <Header settings={settings} pathname={pathname} />
    <main
      id="main-content"
      class:list={{ 'overflow-hidden': pathname !== '/' }}
    >
      <slot />
    </main>
    {showFooter && <Footer settings={settings} isHome={pathname === '/'} />}
    {preview.enabled && (
      <a
        href={exitPreviewHref}
        class="fixed right-4 bottom-4 z-[1001] rounded-full bg-dark px-5 py-3 font-body text-sm font-bold text-light shadow-lg"
      >
        Exit preview
      </a>
    )}
    <VisualEditing enabled={preview.enabled} zIndex={1000} />
  </body>
</html>
