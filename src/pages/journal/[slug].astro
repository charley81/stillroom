---
import { Image } from 'astro:assets'
import { getCollection, type CollectionEntry } from 'astro:content'
import ArticleBody from '../../components/journal/ArticleBody.astro'
import ArticleIntroduction from '../../components/journal/ArticleIntroduction.astro'
import RelatedArticles from '../../components/journal/RelatedArticles.astro'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const articles = await getCollection(
    'journalArticles',
    ({ data }) => data.detailAvailable,
  )

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }))
}

interface Props {
  article: CollectionEntry<'journalArticles'>
}

const { article } = Astro.props
const allArticles = await getCollection('journalArticles')
const related = article.data.relatedArticles.flatMap((articleId) => {
  const relatedArticle = allArticles.find((entry) => entry.id === articleId)
  return relatedArticle ? [relatedArticle] : []
})
---

<Layout
  title={`${article.data.title} — Stillroom Journal`}
  description={article.data.excerpt}
>
  <ArticleIntroduction article={article} />

  <figure class="m-0 flex flex-col gap-4 px-4 md:px-8">
    <Image
      class="h-[189.535px] w-full object-cover md:h-[800px]"
      src={article.data.heroImage.src}
      alt={article.data.heroImage.alt}
      width={1376}
      height={800}
    />
    {article.data.heroImage.caption && (
      <figcaption class="max-w-[720px] text-sm leading-6 text-dark-grey md:ml-[352px]">
        {article.data.heroImage.caption}
      </figcaption>
    )}
  </figure>

  <ArticleBody article={article} />
  <RelatedArticles articles={related} />
</Layout>
