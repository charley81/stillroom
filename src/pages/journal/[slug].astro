---
import EditorialImage from '../../components/content/EditorialImage.astro'
import ArticleBody from '../../components/journal/ArticleBody.astro'
import ArticleIntroduction from '../../components/journal/ArticleIntroduction.astro'
import RelatedArticles from '../../components/journal/RelatedArticles.astro'
import Layout from '../../layouts/Layout.astro'
import {
  getJournalArticlePage,
  JournalArticleNotFoundError,
} from '../../sanity/content'
import { PUBLIC_PREVIEW_STATE } from '../../sanity/preview'

const slug = Astro.params.slug
if (!slug) return Astro.rewrite('/404')

const preview = Astro.locals.preview ?? PUBLIC_PREVIEW_STATE
let content
try {
  content = await getJournalArticlePage(slug, preview)
} catch (error) {
  if (error instanceof JournalArticleNotFoundError) {
    return Astro.rewrite('/404')
  }
  throw error
}
const { article } = content
const title = article.seo?.metaTitle ?? `${article.title} — Stillroom Journal`
const description = article.seo?.metaDescription ?? article.standfirst
const socialImageUrl = article.seo?.socialImageUrl ?? article.heroImage.url
---

<Layout title={title} description={description} socialImageUrl={socialImageUrl}>
  <ArticleIntroduction article={article} />

  <figure class="m-0 flex flex-col gap-4 px-4 md:px-8">
    <EditorialImage
      class="h-[189.535px] w-full object-cover md:h-[800px]"
      image={article.heroImage}
      width={1376}
      height={800}
      loading="eager"
      fetchpriority="high"
    />
    {article.heroImage.caption && (
      <figcaption class="max-w-[720px] text-sm leading-6 text-dark-grey md:ml-[352px]">
        {article.heroImage.caption}
      </figcaption>
    )}
  </figure>

  <ArticleBody article={article} />
  <RelatedArticles articles={article.relatedJournalArticles} />
</Layout>
