---
import { getCollection, type CollectionEntry } from 'astro:content'
import ArticleIntroduction from '../../components/journal/ArticleIntroduction.astro'
import WhatMakesAPlaceBody from '../../components/journal/WhatMakesAPlaceBody.astro'
import RelatedArticles from '../../components/journal/RelatedArticles.astro'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const articles = await getCollection(
    'journalArticles',
    ({ data }) => data.detailAvailable,
  )
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }))
}

interface Props {
  article: CollectionEntry<'journalArticles'>
}
const { article } = Astro.props
const allArticles = (await getCollection('journalArticles')).sort(
  (a, b) => a.data.order - b.data.order,
)
const related = allArticles
  .filter((entry) => entry.id !== article.id)
  .slice(0, 2)
---

<Layout
  title={`${article.data.title} — Stillroom Journal`}
  description={article.data.excerpt}
>
  <ArticleIntroduction article={article} />

  <div class="h-[189.535px] px-4 md:h-[800px] md:px-8">
    <img
      class="h-[189.535px] w-full object-cover md:h-[800px]"
      src="/images/387-4032.webp"
      alt="The Good Table before opening"
    />
  </div>

  <WhatMakesAPlaceBody />

  <RelatedArticles articles={related} />
</Layout>
