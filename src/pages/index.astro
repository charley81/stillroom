---
import HomeHero from '../components/home/HomeHero.astro'
import JournalHighlights from '../components/home/JournalHighlights.astro'
import ProcessOverview from '../components/home/ProcessOverview.astro'
import SelectedConcepts from '../components/home/SelectedConcepts.astro'
import ServicesOverview from '../components/home/ServicesOverview.astro'
import StudioIntro from '../components/home/StudioIntro.astro'
import ClientLogoFonts from '../components/site/ClientLogoFonts.astro'
import ClientLogos from '../components/site/ClientLogos.astro'
import ProjectInvitation from '../components/site/ProjectInvitation.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <ClientLogoFonts slot="head" />

  <HomeHero />

  <section class="flex h-[694px] flex-col gap-8 px-4 py-16 md:h-[417px] md:px-8 md:py-32">
    <p class="m-0 font-body text-base leading-[14.85px] font-black text-dark-grey uppercase">
      <span class="hidden md:inline">
        Explorations in hospitality / Concept brands
      </span>
      <span class="inline md:hidden">Explorations in hospitality</span>
    </p>
    <ClientLogos />
  </section>

  <SelectedConcepts />

  <ServicesOverview />

  <section class="flex h-[369px] flex-col gap-8 px-4 py-16 md:h-[505px] md:px-8 md:py-32">
    <p class="m-0 font-body text-base leading-[16.2px] font-black text-dark-grey uppercase">
      Made for the world of hospitality
    </p>
    <h2 class="m-0 font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[100px]">
      Restaurants / Boutique hotels
      <br />
      Cafés & bars / Food & drink
    </h2>
  </section>

  <StudioIntro />

  <section class="relative isolate flex h-[440px] flex-col gap-8 overflow-hidden bg-primary bg-[length:1440px_1002px] bg-left-top bg-no-repeat px-4 py-16 text-light after:absolute after:inset-0 after:-z-10 after:bg-dark after:opacity-[0.64] after:content-[''] md:h-[506px] md:px-8 md:py-32">
    <p class="m-0 font-body text-base leading-[16.2px] font-black text-light uppercase">
      Our point of view
    </p>
    <h2 class="m-0 font-display text-5xl leading-12 font-normal text-light uppercase md:text-[72px] md:leading-[74.88px]">
      A good brand should feel
      <br />
      like a place you belong!
    </h2>
    <p class="m-0 text-base leading-[20.25px] text-light">
      The Stillroom approach / Strategy, identity and digital, together.
    </p>
  </section>

  <ProcessOverview />

  <JournalHighlights />

  <ProjectInvitation />
</Layout>
