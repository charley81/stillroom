---
import ClientProof from '../components/about/ClientProof.astro'
import FounderStory from '../components/about/FounderStory.astro'
import TeamOverview from '../components/about/TeamOverview.astro'
import WorkingPrinciples from '../components/about/WorkingPrinciples.astro'
import ClientLogoFonts from '../components/site/ClientLogoFonts.astro'
import ProjectInvitation from '../components/site/ProjectInvitation.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="About — Stillroom"
  description="Stillroom is a small independent creative studio with plenty of soul."
>
  <ClientLogoFonts slot="head" />

  <section class="flex h-[260px] flex-col gap-16 overflow-hidden px-4 pt-4 pb-16 md:h-[1320px] md:px-8 md:pt-20 md:pb-16">
    <p class="m-0 font-body text-base leading-5 font-normal text-dark-grey uppercase">
      About Stillroom
    </p>
    <h1 class="m-0 w-full font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[128px] md:leading-[1.05]">
      Small team.
      <br />
      Plenty of soul.
    </h1>
    <img
      class="hidden h-[760px] w-full max-w-none object-cover md:block"
      src="/images/387-3526.webp"
      alt="Stillroom table collage"
    />
  </section>

  <FounderStory />

  <TeamOverview />

  <WorkingPrinciples />

  <ClientProof />

  <ProjectInvitation
    eyebrow="Good people. Good projects. Let’s meet."
    variant="about"
  />
</Layout>
