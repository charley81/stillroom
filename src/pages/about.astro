---
import ClientProof from '../components/about/ClientProof.astro'
import FounderStory from '../components/about/FounderStory.astro'
import TeamOverview from '../components/about/TeamOverview.astro'
import WorkingPrinciples from '../components/about/WorkingPrinciples.astro'
import EditorialImage from '../components/content/EditorialImage.astro'
import ProjectInvitation from '../components/site/ProjectInvitation.astro'
import Layout from '../layouts/Layout.astro'

const { content: page, siteSettings } =
  await Astro.locals.content.loadAboutPage()
const title = page.seo?.metaTitle ?? `${page.heading} — Stillroom`
const description =
  page.seo?.metaDescription ??
  page.teamIntroduction ??
  'Stillroom is a small independent creative studio with plenty of soul.'
const socialImageUrl = page.seo?.socialImageUrl ?? page.heroImage.url
---

<Layout
  settings={siteSettings}
  title={title}
  description={description}
  socialImageUrl={socialImageUrl}
>
  <section class="flex min-h-[260px] flex-col gap-16 px-4 pt-4 pb-16 md:min-h-[1320px] md:px-8 md:pt-20 md:pb-16">
    <p class="m-0 font-body text-base leading-5 font-normal text-dark-grey uppercase">
      About Stillroom
    </p>
    <h1 class="m-0 w-full whitespace-pre-line font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[128px] md:leading-[1.05]">
      {page.heading}
    </h1>
    <EditorialImage
      class="hidden h-[760px] w-full max-w-none object-cover md:block"
      image={page.heroImage}
      width={1024}
      height={566}
      sizes="(min-width: 768px) calc(100vw - 64px), 1px"
      loading="eager"
      fetchpriority="high"
    />
  </section>
  <FounderStory page={page} />
  <TeamOverview page={page} />
  <WorkingPrinciples page={page} />
  <ClientProof page={page} />
  <ProjectInvitation
    eyebrow={page.finalCtaEyebrow}
    title={page.finalCtaHeading}
    label={page.finalCtaLabel}
    variant="about"
  />
</Layout>
