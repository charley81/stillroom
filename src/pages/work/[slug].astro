---
import { Image } from 'astro:assets'
import { getCollection, type CollectionEntry } from 'astro:content'
import NextProject from '../../components/work/NextProject.astro'
import ProjectGallery from '../../components/work/ProjectGallery.astro'
import ProjectIntroduction from '../../components/work/ProjectIntroduction.astro'
import ProjectNarrative from '../../components/work/ProjectNarrative.astro'
import ProjectOutcome from '../../components/work/ProjectOutcome.astro'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const projects = (
    await getCollection('workProjects', ({ data }) => data.detailAvailable)
  ).sort((a, b) => a.data.order - b.data.order)

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      nextProject: projects[(index + 1) % projects.length],
    },
  }))
}

interface Props {
  project: CollectionEntry<'workProjects'>
  nextProject: CollectionEntry<'workProjects'>
}

const { project, nextProject } = Astro.props
---

<Layout
  title={`${project.data.title} — Stillroom`}
  description={project.data.summary}
>
  <ProjectIntroduction project={project} />

  <Image
    class="h-[243.75px] w-full object-cover md:h-[900px]"
    src={project.data.heroImage.src}
    alt={project.data.heroImage.alt}
    width={1440}
    height={900}
  />

  <ProjectNarrative project={project} />
  <ProjectGallery project={project} />
  <ProjectOutcome project={project} />
  <NextProject project={nextProject} />
</Layout>
