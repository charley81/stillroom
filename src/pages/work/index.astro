---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/content/ProjectCard.astro';
import ProjectInvitation from '../../components/site/ProjectInvitation.astro';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('workProjects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Work — Stillroom" description="Selected hospitality branding and digital work by Stillroom.">
	<section class="page-intro">
		<div class="section-inner"><p class="eyebrow">Our work / Independent hospitality</p></div>
		<div class="page-intro__split">
			<h1>Places with personality.</h1>
			<img src="/images/381-1857.webp" alt="Abstract red Stillroom artwork" />
		</div>
	</section>
	<div class="section-inner"><p class="eyebrow">Our work</p></div>
	<section class="project-list" aria-label="Work Projects">
		{projects.map((project) => <ProjectCard project={project} />)}
	</section>
	<ProjectInvitation class="work-invitation" />
</Layout>
