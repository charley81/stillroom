---
import ContactInquiry from '../components/contact/ContactInquiry.astro'
import Layout from '../layouts/Layout.astro'

const { content: page, siteSettings } =
  await Astro.locals.content.loadContactPage()
const title = page.seo?.metaTitle ?? `${page.heading} — Stillroom`
const description = page.seo?.metaDescription ?? page.introduction
const socialImageUrl = page.seo?.socialImageUrl ?? page.supportingImage.url
---

<Layout
  settings={siteSettings}
  title={title}
  description={description}
  socialImageUrl={socialImageUrl}
>
  <ContactInquiry page={page} />
</Layout>
