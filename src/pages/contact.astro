---
import Layout from '../layouts/Layout.astro'
import Button from '../components/site/Button.astro'
---

<Layout
  title="Contact — Stillroom"
  description="Tell Stillroom about your hospitality brand or digital project."
>
  <section class="contact-page">
    <div class="contact-intro">
      <p class="eyebrow">Your next chapter</p>
      <h1>
        Pull up
        <br />a chair.
      </h1>
      <p class="lede">
        Every good collaboration starts with a conversation. A few details will
        help us get to know you.
      </p>
      <img src="/images/382-3276.webp" alt="Stillroom invitation stationery" />
      <p class="eyebrow red">A little thinking. A lot of possibility.</p>
    </div>
    <form class="contact-form" data-contact-form novalidate>
      <h2>Tell us about your project</h2>
      <p>* Required fields. A rough idea is a perfectly good start.</p>
      <div class="form-grid">
        <div class="field">
          <label for="name">Name *</label>
          <input id="name" name="name" placeholder="Your name" required />
        </div>
        <div class="field">
          <label for="email">Email *</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="you@yourbusiness.com"
            required
          />
        </div>
        <div class="field field--full">
          <label for="business">Business or brand *</label>
          <input
            id="business"
            name="business"
            placeholder="What’s the name of your business?"
            required
          />
        </div>
        <fieldset class="service-options">
          <legend>Services needed *</legend>
          <p>Select all that apply.</p>
          <div class="checkbox-grid">
            <label>
              <input type="checkbox" name="services" value="Brand strategy" />{' '}
              Brand strategy
            </label>
            <label>
              <input type="checkbox" name="services" value="Visual identity" />{' '}
              Visual identity
            </label>
            <label>
              <input
                type="checkbox"
                name="services"
                value="Digital design and development"
              />{' '}
              Digital design & development
            </label>
            <label>
              <input
                type="checkbox"
                name="services"
                value="Campaign and content direction"
              />{' '}
              Campaign & content direction
            </label>
          </div>
        </fieldset>
        <div class="field">
          <label for="budget">Approximate budget range</label>
          <select id="budget" name="budget">
            <option value="">Select a range</option>
            <option>£10k–£25k</option>
            <option>£25k–£50k</option>
            <option>£50k+</option>
          </select>
        </div>
        <div class="field">
          <label for="timing">Target timing</label>
          <input
            id="timing"
            name="timing"
            placeholder="When would you like to launch?"
          />
        </div>
        <div class="field field--full">
          <label for="description">Project description *</label>
          <textarea
            id="description"
            name="description"
            placeholder="Tell us about your idea, where you are now, and where you’d like to go."
            required
          ></textarea>
        </div>
      </div>
      <Button type="submit" variant="solid" class="contact-submit">
        Send inquiry
      </Button>
      <p class="privacy-note">
        By sending this form, you agree that we may use these details to respond
        to your inquiry.
      </p>
      <p class="form-status" aria-live="polite"></p>
    </form>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    const selectedServices = form.querySelectorAll<HTMLInputElement>(
      'input[name="services"]:checked',
    )
    const status = form.querySelector<HTMLElement>('.form-status')
    if (!form.reportValidity()) return
    if (selectedServices.length === 0) {
      if (status) status.textContent = 'Select at least one service.'
      form.querySelector<HTMLInputElement>('input[name="services"]')?.focus()
      return
    }
    if (status)
      status.textContent =
        'This inquiry is ready to connect to your form service.'
  })
</script>
