---
import Layout from '../layouts/Layout.astro'
import Button from '../components/site/Button.astro'
---

<Layout
  title="Services — Stillroom"
  description="Brand strategy, identity, digital design and campaigns for hospitality."
>
  <section class="services-hero">
    <div class="services-hero__grid">
      <div>
        <p class="eyebrow">Services / Stillroom</p>
        <h1>
          A little
          <br />
          good thinking.
        </h1>
        <p class="lede">
          Brand strategy, identity, websites and campaigns. Thoughtful from
          first idea to final detail.
        </p>
        <Button href="/contact" variant="light" class="services-hero__button">
          Start a Project
        </Button>
      </div>
      <img src="/images/375-1387.webp" alt="Red napkin and service bell" />
    </div>
  </section>

  <div class="section-inner">
    <p class="eyebrow">01 / Our services</p>
  </div>
  <section class="service-card-grid">
    <article
      class="service-card"
      style="background-image:url('/images/375-1392.webp')"
    >
      <div class="service-card__content">
        <span class="service-card__number">1</span>
        <h2>
          Brand
          <br />
          strategy
        </h2>
        <p>
          Find the idea worth building around. We get close to your people, your
          place and the things that make your business worth knowing.
        </p>
        <h3>What we shape</h3>
        <ul>
          <li>Discovery & research</li>
          <li>Positioning & audience</li>
          <li>Brand purpose & personality</li>
          <li>Messaging & tone of voice</li>
          <li>Brand architecture</li>
        </ul>
      </div>
    </article>
    <article
      class="service-card"
      style="background-image:url('/images/375-1393.webp')"
    >
      <div class="service-card__content">
        <span class="service-card__number">2</span>
        <h2>
          Visual
          <br />
          identity
        </h2>
        <p>
          A character all your own. Distinctive identities with the range to
          move from a matchbox to a front door, and everywhere in between.
        </p>
        <h3>What we shape</h3>
        <ul>
          <li>Creative & art direction</li>
          <li>Logo & identity system</li>
          <li>Colour & typography</li>
          <li>Menus, signage & packaging</li>
          <li>Guidelines & brand toolkit</li>
        </ul>
      </div>
    </article>
    <article
      class="service-card"
      style="background-image:url('/images/375-1395.webp')"
    >
      <div class="service-card__content">
        <span class="service-card__number">3</span>
        <h2>
          Digital design
          <br />& development
        </h2>
        <p>
          An experience before the experience. Websites that express your
          character and make the next step feel effortless.
        </p>
        <h3>What we shape</h3>
        <ul>
          <li>Digital strategy & user experience</li>
          <li>Website design</li>
          <li>Responsive development</li>
          <li>Booking & enquiry journeys</li>
          <li>CMS setup & handover</li>
        </ul>
      </div>
    </article>
    <article
      class="service-card"
      style="background-image:url('/images/375-1396.webp')"
    >
      <div class="service-card__content">
        <span class="service-card__number">4</span>
        <h2>
          Campaign &<br />
          content direction
        </h2>
        <p>
          Give your story a life beyond the launch. Ideas, images and words that
          bring the brand into the world with confidence.
        </p>
        <h3>What we shape</h3>
        <ul>
          <li>Campaign & launch concepts</li>
          <li>Photography & film direction</li>
          <li>Copy & editorial direction</li>
          <li>Social & campaign assets</li>
          <li>Ongoing creative direction</li>
        </ul>
      </div>
    </article>
  </section>

  <section class="connect-section">
    <div class="section-inner">
      <p class="eyebrow">02 / How the work connects</p>
      <h2 class="display-medium">
        The whole is
        <br />
        better together.
      </h2>
    </div>
    <div class="phase-grid">
      <div>
        <h3>01 / Discover</h3>
        <p>Get close to your people, your place and your ambitions.</p>
      </div>
      <div>
        <h3>02 / Define</h3>
        <p>Find the direction that feels distinctly yours.</p>
      </div>
      <div>
        <h3>03 / Create</h3>
        <p>Bring the idea to life across identity and experience.</p>
      </div>
      <div>
        <h3>04 / Launch</h3>
        <p>Open with confidence, a clear toolkit and a considered handover.</p>
      </div>
    </div>
  </section>

  <section class="sectors">
    <div class="section-inner">
      <p class="eyebrow">03 / Made for hospitality</p>
      <h2 class="display-medium">
        For places
        <br />
        with character.
      </h2>
    </div>
    <div class="sectors-grid">
      <div>
        <h3 class="display-small">
          Restaurants / Boutique hotels
          <br />
          Cafés & bars / Food & drink
        </h3>
        <p class="lede">
          The best hospitality brands are built around a clear point of view,
          then carried through every detail of the experience.
        </p>
        <a class="red" href="/work">
          Explore our hospitality concepts ↗
        </a>
      </div>
      <img
        src="/images/375-1425.webp"
        alt="Hospitality objects and brand materials"
      />
    </div>
  </section>

  <section class="project-invitation services-final-cta arch-pattern">
    <div class="section-inner">
      <p class="eyebrow">Something good starts here</p>
      <h2 class="display-title">
        Bring it
        <br />
        all together.
      </h2>
    </div>
  </section>
</Layout>
