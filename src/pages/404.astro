---
import { Image } from 'astro:assets'
import Button from '../components/site/Button.astro'
import Layout from '../layouts/Layout.astro'

const settings = await Astro.locals.content.getSiteSettings()
---

<Layout settings={settings} title="Page Not Found — Stillroom" noindex>
  <section class="flex min-h-[540px] flex-col items-center justify-start gap-8 px-4 pt-4 pb-20 text-center md:min-h-[826px] md:px-16 md:py-20">
    <Image
      class="h-[131px] w-full max-w-[358px] object-contain md:h-[400px] md:max-w-[800px]"
      src="/images/387-3481.webp"
      alt="404 in red letterpress ribbon lettering"
      width={800}
      height={400}
      loading="eager"
      fetchpriority="high"
    />
    <h1 class="m-0 font-display text-5xl leading-12 font-normal text-dark uppercase md:text-[72px] md:leading-[1.05]">
      Page not found
    </h1>
    <p class="m-0 w-full max-w-[800px] text-base leading-[27px] text-dark-grey">
      The page you’re looking for has moved, or never made it to the menu.
      <br />
      Let’s find you somewhere good to go.
    </p>
    <Button href="/" variant="solid">
      Back to Home
    </Button>
  </section>
</Layout>
