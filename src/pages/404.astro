---
import Layout from '../layouts/Layout.astro';
import Button from '../components/site/Button.astro';
---

<Layout title="Page Not Found — Stillroom">
	<section class="not-found">
		<img src="/images/387-3481.webp" alt="404 in red letterpress ribbon lettering" />
		<h1>This table isn’t here.</h1>
		<p class="lede">The page you’re looking for has moved, or never made it to the menu.<br />Let’s find you somewhere good to go.</p>
		<Button href="/" variant="solid" class="recovery-button">Back to Home</Button>
	</section>
</Layout>
